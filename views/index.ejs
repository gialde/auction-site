<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Аукционы — Главная</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="container">
    <!-- Шапка -->
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; margin-bottom: 20px;">
      <h1 style="border: none; margin: 0;">Аукционы</h1>
      <div style="display: flex; gap: 10px; align-items: center;">
        <% if (user) { %>
          <a href="/create-item"><button style="background:#4CAF50;">Создать лот</button></a>
          <a href="/profile"><button style="background:#2a2a45; color:#c9a96e;">Профиль</button></a>
          <a href="/favorites"><button style="background:#2a2a45; color:#c9a96e;">Избранное</button></a>
          <a href="/cart"><button style="background:#2a2a45; color:#c9a96e;">Корзина</button></a>
          <span style="color: #c9a96e; margin: 0 10px;"><%= user.full_name %></span>
          <a href="/logout"><button style="background:#ff6b6b; color:#fff;">Выйти</button></a>
        <% } else { %>
          <a href="/login"><button>Войти</button></a>
          <a href="/register"><button style="background:#2a2a45; color:#c9a96e;">Регистрация</button></a>
        <% } %>
      </div>
    </div>

    <!-- Поиск -->
    <form method="get" action="/" style="margin: 20px 0; display: flex; gap: 10px;">
      <input type="text" name="search" placeholder="Поиск по названию..." value="<%= search || '' %>" style="margin:0;">
      <select name="auction_filter" style="width: auto; margin:0;">
        <option value="">Все аукционы</option>
        <% auctions.forEach(a => { %>
          <option value="<%= a.id %>" <%= (auction_filter && auction_filter == a.id) ? 'selected' : '' %>><%= a.name %></option>
        <% }) %>
      </select>
      <button type="submit">Найти</button>
    </form>

    <!-- Ссылка на админку -->
    <% if (user && user.role === 'admin') { %>
      <a href="/admin"><button style="background:#c9a96e; color:#1a1a2e;">Админ-панель</button></a>
    <% } %>
    

    <!-- Лоты -->
    <h2>Лоты</h2>
    <% if (items.length === 0) { %>
      <p>Лотов не найдено.</p>
    <% } else { %>
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px;">
        <% items.forEach(item => { %>
          <div style="background: #252540; border-radius: 12px; padding: 20px; border: 1px solid #3a3a55; display: flex; flex-direction: column; justify-content: space-between;">
            <div>
              <h3 style="margin:0 0 10px; color: #e0e0e0;">
                <a href="/item/<%= item.id %>" style="color: #e0e0e0; text-decoration: none;"><%= item.name %></a>
              </h3>
              <p style="color: #888; font-size:13px; margin-bottom: 10px;"><%= item.description || 'Нет описания' %></p>
              <p style="font-size: 18px; color: #c9a96e;"><strong><%= item.start_price %> руб.</strong></p>
              <p style="font-size:12px; color:#888;">Аукцион: <%= item.auction_name %> | Лот №<%= item.lot_number %></p>
              <p style="font-size:12px; color:#888;">Дата: <%= new Date(item.auction_date).toLocaleDateString('ru-RU') %></p>
            </div>
            <div style="display: flex; gap: 8px; margin-top: 15px;">
              <% if (user) { %>
                <button onclick="addToFavorites('<%= item.id %>', '<%= item.name %>', <%= item.start_price %>)" style="flex:1; background:#ff6b6b;">❤️ В избранное</button>
                <button onclick="addToCart('<%= item.id %>', '<%= item.name %>', <%= item.start_price %>)" style="flex:1; background:#2a2a45; color:#c9a96e;">🛒 В корзину</button>
              <% } else { %>
                <button onclick="alert('Войдите в аккаунт!')" style="flex:1; opacity:0.5;">❤️ В избранное</button>
                <button onclick="alert('Войдите в аккаунт!')" style="flex:1; opacity:0.5;">🛒 В корзину</button>
              <% } %>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>

    <p style="margin-top:30px; text-align:center; color:#888;">Аукционная система © 2026</p>
  </div>

  <script>
  const userId = '<%= user ? user.id : "guest" %>';
  
  function addToFavorites(id, name, price) {
    let favs = JSON.parse(localStorage.getItem('favorites_' + userId) || '[]');
    if (!favs.find(f => f.id === id)) {
      favs.push({ id, name, price });
      localStorage.setItem('favorites_' + userId, JSON.stringify(favs));
      alert('Добавлено в избранное!');
    } else {
      alert('Уже в избранном!');
    }
  }
  
  function addToCart(id, name, price) {
    let cart = JSON.parse(localStorage.getItem('cart_' + userId) || '[]');
    if (!cart.find(c => c.id === id)) {
      cart.push({ id, name, price });
      localStorage.setItem('cart_' + userId, JSON.stringify(cart));
      alert('Добавлено в корзину!');
    } else {
      alert('Уже в корзине!');
    }
  }
</script>
</body>
</html>