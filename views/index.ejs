<!DOCTYPE html>
<html>
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Аукционы — Премиум</title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .lot-card-link {
      text-decoration: none;
      color: inherit;
      display: block;
    }
    .lot-card-link .lot-card {
      transition: all 0.4s ease;
    }
    .lot-card-link:hover .lot-card {
      border-color: #c9a96e;
      transform: translateY(-5px);
      box-shadow: 0 20px 50px rgba(0,0,0,0.5);
    }
  </style>
</head>
<body>

<!-- HEADER -->
<header class="header">
  <div class="header-inner">
    <a href="/" class="logo">AURUM</a>
    <nav class="nav-links">
      <a href="/">Главная</a>
      <% if (user) { %>
        <a href="/profile">Профиль</a>
        <a href="/favorites">Избранное</a>
        <a href="/cart">Корзина</a>
        <a href="/create-item">Выставить лот</a>
        <% if (user.role === 'admin') { %>
          <a href="/admin">Админ</a>
          <a href="/admin/support">Поддержка</a>
        <% } else { %>
          <a href="/support">Поддержка</a>
        <% } %>
        <span style="color:#c9a96e; margin:0 10px;"><%= user.full_name %></span>
        <a href="/logout" class="btn-outline">Выйти</a>
      <% } else { %>
        <a href="/login" class="btn-outline">Войти</a>
        <a href="/register" class="btn-filled">Регистрация</a>
      <% } %>
    </nav>
  </div>
</header>

<!-- HERO -->
<section class="hero">
  <h1>AUCTION HOUSE</h1>
  <p>Эксклюзивные лоты. Честные ставки. Премиум-сервис.</p>
  <form method="get" action="/" style="display:flex; gap:15px; justify-content:center; max-width:600px; margin:0 auto;">
    <input type="text" name="search" placeholder="Поиск..." value="<%= search || '' %>" style="margin:0; background:#1a1a1a; border-color:#333;">
    <select name="auction_filter" style="width:auto; margin:0; background:#1a1a1a; border-color:#333;">
      <option value="">Все аукционы</option>
      <% auctions.forEach(a => { %>
        <option value="<%= a.id %>" <%= (auction_filter && auction_filter == a.id) ? 'selected' : '' %>><%= a.name %></option>
      <% }) %>
    </select>
    <button type="submit" style="white-space:nowrap;">Найти</button>
  </form>
</section>

<!-- LOTS -->
<div class="main-container">
  <h2 class="section-title">Текущие лоты</h2>
  
  <% if (items.length === 0) { %>
    <p style="text-align:center; color:#666;">Лотов пока нет.</p>
  <% } else { %>
    <div class="lots-grid">
      <% items.forEach(item => { %>
        <a href="/item/<%= item.id %>" class="lot-card-link" style="text-decoration: none; color: inherit; display: block;">
          <div class="lot-card">
            <div class="lot-card-image">🏛️</div>
            <div class="lot-card-body">
              <h3><%= item.name %></h3>
              <p class="price"><%= item.start_price.toLocaleString() %> ₽</p>
              <p class="meta"><%= item.auction_name %> | Лот №<%= item.lot_number %></p>
              <p class="meta"><%= new Date(item.auction_date).toLocaleDateString('ru-RU') %></p>
              <div class="actions">
                <% if (user) { %>
                  <button onclick="event.preventDefault(); event.stopPropagation(); addToFavorites('<%= item.id %>', '<%= item.name %>', <%= item.start_price %>)">Избранное</button>
                  <button onclick="event.preventDefault(); event.stopPropagation(); addToCart('<%= item.id %>', '<%= item.name %>', <%= item.start_price %>)">В корзину</button>
                <% } else { %>
                  <button onclick="event.preventDefault(); event.stopPropagation(); alert('Войдите!')" style="opacity:0.5;">Избранное</button>
                  <button onclick="event.preventDefault(); event.stopPropagation(); alert('Войдите!')" style="opacity:0.5;">Корзина</button>
                <% } %>
              </div>
            </div>
          </div>
        </a>
      <% }) %>
    </div>
  <% } %>
</div>

<!-- FOOTER -->
<footer class="footer">
  <p>© 2026 AURUM Auction House. Все права защищены.</p>
</footer>

<script>
const userId = '<%= user ? user.id : "guest" %>';
function addToFavorites(id, name, price) {
  let favs = JSON.parse(localStorage.getItem('favorites_' + userId) || '[]');
  if (!favs.find(f => f.id === id)) {
    favs.push({ id, name, price });
    localStorage.setItem('favorites_' + userId, JSON.stringify(favs));
    alert('Добавлено в избранное!');
  } else { alert('Уже в избранном!'); }
}
function addToCart(id, name, price) {
  let cart = JSON.parse(localStorage.getItem('cart_' + userId) || '[]');
  if (!cart.find(c => c.id === id)) {
    cart.push({ id, name, price });
    localStorage.setItem('cart_' + userId, JSON.stringify(cart));
    alert('Добавлено в корзину!');
  } else { alert('Уже в корзине!'); }
}
</script>
</body>
</html>