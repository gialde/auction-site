<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AURUM — Запрос 1</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="header">
    <div class="header-inner">
      <a href="/" class="logo">AURUM</a>
      <nav class="nav-links">
        <a href="/">Главная</a>
        <a href="/admin">Админ</a>
        <a href="/logout" class="btn-outline">Выйти</a>
      </nav>
    </div>
  </header>

  <div class="container-wide">
    <h1>Предметы на заданном аукционе</h1>
    
    <form method="POST" action="/query1" style="margin-bottom: 30px;">
      <div style="display: flex; gap: 15px; align-items: baseline; flex-wrap: wrap;">
        <div style="flex: 2;">
          <select name="auction_id" required style="width: 100%;">
            <option value="" disabled selected>-- Выберите аукцион --</option>
            <% auctions.forEach(a => { %>
              <option value="<%= a.id %>"><%= a.name %> (<%= new Date(a.date).toLocaleDateString('ru-RU') %>)</option>
            <% }) %>
          </select>
        </div>
        <div>
          <button type="submit">Показать</button>
        </div>
      </div>
    </form>

    <% if (typeof items !== 'undefined') { %>
      <h2>Результаты</h2>
      <% if (items.length === 0) { %>
        <p style="color:#666;">На этом аукционе нет лотов.</p>
      <% } else { %>
        <div style="overflow-x:auto;">
          <table style="width:100%;">
            <thead>
              <tr><th>ID</th><th>Лот №</th><th>Название</th><th>Стартовая цена</th><th>Продавец</th></tr>
            </thead>
            <tbody>
              <% items.forEach(item => { %>
                <tr>
                  <td><%= item.id %></td>
                  <td><%= item.lot_number %></td>
                  <td><%= item.name %></td>
                  <td style="color:#c9a96e;"><%= item.start_price %> ₽</td>
                  <td><%= item.creator_name %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    <% } %>
    
    <p style="margin-top: 20px;"><a href="/admin">← Назад в админ-панель</a></p>
  </div>

  <footer class="footer">
    <p>© 2026 AURUM Auction House</p>
  </footer>
</body>
</html>