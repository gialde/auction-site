<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Запрос 1 – Предметы на дату и аукцион</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="container">
    <h1>Предметы на заданную дату и аукцион</h1>
    <p><a href="/">← На главную</a></p>
    
    <form method="POST" action="/query1">
  <label>Выберите аукцион:</label><br>
  <select name="auction_id" required style="width:100%; margin-bottom:10px;">
    <option value=""disabled selected>-- выберите --</option>
    <% auctions.forEach(a => { %>
      <option value="<%= a.id %>"><%= a.name %> (<%= new Date(a.date).toLocaleDateString('ru-RU') %>)</option>
    <% }) %>
  </select><br>
  <button type="submit">Показать предметы</button>
</form>

    <% if (typeof items !== 'undefined') { %>
      <h2>Результаты</h2>
      <% if (items.length === 0) { %>
        <p>Ничего не найдено.</p>
      <% } else { %>
        <table>
          <tr>
            <th>ID предмета</th>
            <th>Лот №</th>
            <th>Название</th>
            <th>Стартовая цена</th>
            <th>Продавец</th>
          </tr>
          <% items.forEach(item => { %>
            <tr>
              <td><%= item.id %></td>
              <td><%= item.lot_number %></td>
              <td><%= item.name %></td>
              <td><%= item.start_price %></td>
              <td><%= item.seller %></td>
            </tr>
          <% }); %>
        </table>
      <% } %>
    <% } %>
  </div>
</body>
</html>