<!DOCTYPE html>
<html>
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AURUM — Профиль</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<header class="header">
  <div class="header-inner">
    <a href="/" class="logo">AURUM</a>
    <nav class="nav-links">
      <a href="/">Главная</a>
      <a href="/favorites">Избранное</a>
      <a href="/cart">Корзина</a>
      <a href="/create-item">Выставить лот</a>
      <a href="/support">Поддержка</a>
      <a href="/logout" class="btn-outline">Выйти</a>
    </nav>
  </div>
</header>

<div class="container-wide">
  <h1>Профиль</h1>
  
    <div style="border:1px solid #222; padding:20px;">
      <p style="color:#666;">Фамилия</p>
      <p style="font-size:18px;"><%= profile.last_name || '—' %></p>
      <p style="color:#666;margin-top:15px;">Имя</p>
      <p style="font-size:18px;"><%= profile.first_name || '—' %></p>
      <p style="color:#666;margin-top:15px;">Отчество</p>
      <p style="font-size:18px;"><%= profile.middle_name || '—' %></p>
      <p style="color:#666;margin-top:15px;">Email</p>
      <p><%= profile.email %></p>
      <p style="color:#666;margin-top:15px;">Паспорт</p>
      <p><%= profile.passport || '—' %></p>
      <p style="color:#666;margin-top:15px;">Телефон</p>
      <p><%= profile.phone || '—' %></p>
      <a href="/profile/edit"><button style="margin-top:15px;">✏️ Редактировать</button></a>
    </div>

  <h2>Мои ставки</h2>
  <% if (myBids.length === 0) { %><p style="color:#666;">Нет ставок.</p><% } else { %>
    <table>
      <tr><th>Лот</th><th>Цена</th><th>Ставка</th><th>Время</th></tr>
      <% myBids.forEach(b => { %>
        <tr>
          <td><%= b.item_name %></td>
          <td><%= b.start_price %> ₽</td>
          <td style="color:#c9a96e;"><%= b.amount %> ₽</td>
          <td><%= new Date(b.bid_time).toLocaleString('ru-RU') %></td>
        </tr>
      <% }) %>
    </table>
  <% } %>

  <h2>Мои сделки</h2>
  <% if (deals.length === 0) { %><p style="color:#666;">Нет сделок.</p><% } else { %>
    <table>
      <tr><th>Лот</th><th>Сумма</th><th>Роль</th><th>Статус</th><th>Действия</th></tr>
      <% deals.forEach(d => { %>
        <tr>
          <td><%= d.item_name %></td>
          <td style="color:#c9a96e;"><%= d.amount.toLocaleString() %> ₽</td>
          <td><%= d.buyer_id === user.id ? 'Покупатель' : 'Продавец' %></td>
          <td>
            <% if (d.status === 'pending') { %>Ожидает оплаты
            <% } else if (d.status === 'paid') { %>Оплачен
            <% } else if (d.status === 'shipped') { %>Отправлен
            <% } else if (d.status === 'done') { %>Завершён<% } %>
          </td>
          <td>
            <% if (d.status === 'pending' && d.buyer_id === user.id) { %>
              <form method="post" action="/deal/<%= d.id %>/pay" style="display:inline;">
                <button type="submit" style="padding:8px 16px;font-size:11px;">Оплатить</button>
              </form>
            <% } %>
            <% if (d.status === 'paid') { %>
              <form method="post" action="/deal/<%= d.id %>/ship" style="display:inline;">
                <button type="submit" style="padding:8px 16px;font-size:11px;">Отправить</button>
              </form>
            <% } %>
            <% if (d.status === 'shipped' && d.buyer_id === user.id) { %>
              <form method="post" action="/deal/<%= d.id %>/receive" style="display:inline;">
                <button type="submit" style="padding:8px 16px;font-size:11px;">Получил</button>
              </form>
            <% } %>
            <% if (d.status !== 'pending') { %>
              <a href="/chat/<%= d.id %>"><button style="padding:8px 16px;font-size:11px;">Чат</button></a>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </table>
  <% } %>
</div>

<footer class="footer"><p>© 2026 AURUM Auction House</p></footer>
</body>
</html>