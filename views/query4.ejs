<!DOCTYPE html>
<html>
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Аукцион-рекордсмен</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="container">
    <h1>Аукцион, где продано больше всего предметов</h1>
    <a href="/admin">← В админ-панель</a>
    <% if (auction) { %>
      <p><strong>Название:</strong> <%= auction.name %></p>
      <p><strong>Место:</strong> <%= auction.place %></p>
      <p><strong>Дата:</strong> <%= new Date(auction.date).toLocaleDateString('ru-RU') %></p>
      <p><strong>Продано лотов:</strong> <%= auction.sold %></p>
    <% } else { %>
      <p>Нет данных о продажах.</p>
    <% } %>
  </div>
</body>
</html>