<!DOCTYPE html>
<html>
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Добавление аукциона</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="container" style="max-width: 500px;">
    <h1>📅 Добавить аукцион</h1>
    <a href="/admin/auctions">← Назад</a>
    <% if (message) { %>
      <p style="color: #c9a96e;"><%= message %></p>
    <% } %>
    <form method="post">
      <label>Название:</label>
      <input name="name" required>
      <label>Место:</label>
      <input name="place" required>
      <label>Дата:</label>
      <input type="date" name="date" required>
      <label>Специфика:</label>
      <input name="specifics" placeholder="например: картины маслом до 1900 г.">
      <button type="submit">Создать аукцион</button>
    </form>
  </div>
</body>
</html>