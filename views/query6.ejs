<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AURUM — Запрос 6</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="header">
    <div class="header-inner">
      <a href="/" class="logo">AURUM</a>
      <nav class="nav-links">
        <a href="/">Главная</a>
        <a href="/admin">Админ</a>
        <a href="/logout" class="btn-outline">Выйти</a>
      </nav>
    </div>
  </header>

  <div class="container-wide">
    <h1>Продавец самого дорогого лота</h1>
    
    <% if (seller) { %>
      <div style="background: #0a0a0a; border: 1px solid #222; padding: 30px; margin: 20px 0;">
        <p style="color:#666;">ФИО продавца</p>
        <p style="font-size: 24px; margin-bottom: 20px;"><%= seller.full_name %></p>
        
        <p style="color:#666;">Email</p>
        <p style="font-size: 18px;"><%= seller.email %></p>
        
        <p style="color:#666; margin-top: 15px;">Цена лота</p>
        <p style="font-size: 28px; color: #c9a96e; font-family:'Playfair Display',serif;"><%= seller.final_price %> ₽</p>
      </div>
    <% } else { %>
      <p style="color:#666;">Нет данных о продажах.</p>
    <% } %>
    
    <p style="margin-top: 20px;"><a href="/admin">← Назад в админ-панель</a></p>
  </div>

  <footer class="footer">
    <p>© 2026 AURUM Auction House</p>
  </footer>
</body>
</html>