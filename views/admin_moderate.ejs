<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AURUM — Модерация</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<header class="header">
  <div class="header-inner">
    <a href="/" class="logo">AURUM</a>
    <nav class="nav-links">
      <a href="/">Главная</a>
      <a href="/admin">Админ</a>
      <a href="/logout" class="btn-outline">Выйти</a>
    </nav>
  </div>
</header>

<div class="container-wide" style="overflow-x:auto;">
  <h1>Модерация лотов</h1>

  <% if (pending.length === 0) { %>
    <p style="color:#666;">Нет лотов на модерации.</p>
  <% } else { %>
    <div style="overflow-x:auto;">
      <table>
        <tr><th>Лот</th><th>Аукцион</th><th>Цена</th><th>Создатель</th><th>Действие</th></tr>
        <% pending.forEach(item => { %>
          <tr>
            <td><%= item.name %></td>
            <td><%= item.auction_name %></td>
            <td><%= item.start_price %> ₽</td>
            <td><%= item.creator_email %></td>
            <td>
              <form method="post" action="/admin/moderate/approve" style="display:inline;">
                <input type="hidden" name="item_id" value="<%= item.id %>">
                <button type="submit" style="padding:6px 10px;font-size:10px;">Одобрить</button>
              </form>
              <form method="post" action="/admin/moderate/reject" style="display:inline;">
                <input type="hidden" name="item_id" value="<%= item.id %>">
                <button type="submit" style="padding:6px 10px;font-size:10px;border-color:#ff4444;color:#ff4444;">Отклонить</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </table>
    </div>
  <% } %>
</div>

<footer class="footer"><p>© 2026 AURUM Auction House</p></footer>
</body>
</html>