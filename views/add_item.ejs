<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Управление лотами</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="container">
    <h1>Добавление / удаление предметов на аукционе</h1>
    <a href="/admin">← В админ-панель</a>

    <% if (message) { %>
      <p style="color: green; font-weight: bold;"><%= message %></p>
    <% } %>

    <!-- Выбор аукциона -->
    <form method="post" action="/add-item">
  <input type="hidden" name="action" value="select">
  <label>Выберите аукцион:</label>
  <select name="auction_id" onchange="this.form.submit()">
    <option value="" disabled selected>-- не выбран --</option>
    <% auctions.forEach(auction => { %>
      <option value="<%= auction.id %>" <%= (selectedAuction == auction.id) ? 'selected' : '' %>>
        <%= auction.name %> (<%= new Date(auction.date).toLocaleDateString('ru-RU') %>)
      </option>
    <% }) %>
  </select>
</form>

    <br>

    <!-- Показываем лоты выбранного аукциона -->
    <% if (selectedAuction) { %>
      <h2>Лоты аукциона</h2>
      <% if (lots.length === 0) { %>
        <p>Нет добавленных предметов.</p>
      <% } else { %>
        <table>
          <tr>
            <th>Лот №</th><th>Название</th><th>Старт. цена</th><th>Продавец</th><th>Продан</th><th>Действие</th>
          </tr>
          <% lots.forEach(lot => { %>
            <tr>
              <td><%= lot.lot_number %></td>
              <td><%= lot.name %></td>
              <td><%= lot.start_price %></td>
              <td><%= lot.seller_name %></td>
              <td><%= lot.is_sold ? 'Да' : 'Нет' %></td>
              <td>
                <% if (!lot.is_sold) { %>
                  <form method="post" action="/add-item" style="display:inline" onsubmit="return confirm('Удалить лот?')">
                    <input type="hidden" name="action" value="delete">
                    <input type="hidden" name="auction_id" value="<%= selectedAuction %>">
                    <input type="hidden" name="lot_id" value="<%= lot.id %>">
                    <button type="submit">Удалить</button>
                  </form>
                <% } else { %>
                  <em>Нельзя</em>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </table>
      <% } %>

      <h3>Добавить новый лот</h3>
<form method="post" action="/add-item">
  <input type="hidden" name="action" value="add">
  <input type="hidden" name="auction_id" value="<%= selectedAuction %>">
  
  <label>Продавец:</label><br>
  <select name="seller_id" required style="width:100%; margin-bottom:10px;">
    <% sellers.forEach(s => { %>
      <option value="<%= s.id %>"><%= s.full_name %></option>
    <% }) %>
  </select><br>
  
  <label>Название:</label><br>
  <input name="name" required style="width:100%; margin-bottom:10px;"><br>
  
  <label>Описание:</label><br>
  <textarea name="description" rows="3" style="width:100%; margin-bottom:10px;"></textarea><br>
  
  <label>Начальная цена (руб.):</label><br>
  <input type="number" name="start_price" required> style="width:100%; margin-bottom:10px;"><br>
  
  <button type="submit">Добавить лот</button>
</form>
    <% } %>
  </div>
</body>
</html>