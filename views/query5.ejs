<!DOCTYPE html>
<html>
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Покупатель самого дорогого лота</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="container">
    <h1>Покупатель самого дорогого лота</h1>
    <a href="/admin">← В админ-панель</a>
    <% if (buyer) { %>
      <p><strong>ФИО:</strong> <%= buyer.full_name %></p>
      <p><strong>Паспорт:</strong> <%= buyer.passport %></p>
      <p><strong>Цена лота:</strong> <%= buyer.final_price %> руб.</p>
    <% } else { %>
      <p>Нет данных о продажах.</p>
    <% } %>
  </div>
</body>
</html>