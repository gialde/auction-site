```html
<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AURUM — Пользователи</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<header class="header">
  <div class="header-inner">
    <a href="/" class="logo">AURUM</a>
    <nav class="nav-links">
      <a href="/">Главная</a>
      <a href="/admin">Админ</a>
      <a href="/logout" class="btn-outline">Выйти</a>
    </nav>
  </div>
</header>

<div class="container-wide" style="overflow-x:auto;">
  <h1>Управление пользователями</h1>
  <% if (message) { %><p style="color:#c9a96e;"><%= message %></p><% } %>

  <div style="overflow-x:auto;">
    <table>
      <tr><th>ID</th><th>Email</th><th>ФИО</th><th>Паспорт</th><th>Роль</th><th>Подтв.</th><th>Бан</th><th>Действия</th></tr>
      <% users.forEach(u => { %>
        <tr>
          <td><%= u.id %></td>
          <td><%= u.email %></td>
          <td><%= u.full_name %></td>
          <td><%= u.passport || '—' %></td>
          <td><%= u.role %></td>
          <td><%= u.verified ? '✅' : '❌' %></td>
          <td><%= u.banned ? '🚫' : '✅' %></td>
          <td>
            <% if (u.id !== user.id) { %>
              <% if (u.banned) { %>
                <form method="post" action="/admin/users/unban" style="display:inline;">
                  <input type="hidden" name="user_id" value="<%= u.id %>">
                  <button type="submit" style="padding:6px 10px;font-size:10px;">Разбанить</button>
                </form>
              <% } else { %>
                <form method="post" action="/admin/users/ban" style="display:inline;">
                  <input type="hidden" name="user_id" value="<%= u.id %>">
                  <button type="submit" style="padding:6px 10px;font-size:10px;">Забанить</button>
                </form>
              <% } %>
              <form method="post" action="/admin/users/delete" style="display:inline;" onsubmit="return confirm('Удалить?')">
                <input type="hidden" name="user_id" value="<%= u.id %>">
                <button type="submit" style="padding:6px 10px;font-size:10px;border-color:#ff4444;color:#ff4444;">Удалить</button>
              </form>
            <% } else { %>
              <em style="font-size:11px;">Это вы</em>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </table>
  </div>
</div>

<footer class="footer"><p>© 2026 AURUM Auction House</p></footer>
</body>
</html>
```